FROM node:20-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

FROM base AS builder
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @eduforge/db db:generate
RUN pnpm --filter @eduforge/worker build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# Instala dependências do Chromium para captura de telas do INPI (RF-16)
RUN npx playwright install-deps chromium && npx playwright install chromium

COPY --from=builder /app /app

EXPOSE 3334
ENV PORT=3334

CMD ["node", "apps/worker/dist/index.mjs"]
